# AdmitAI Environment Configuration

# AI API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Voice AI Services
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
VAPI_API_KEY=your_vapi_api_key_here
RETELL_AI_API_KEY=your_retell_ai_api_key_here
BLAND_AI_API_KEY=your_bland_ai_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///college_finder.db
MONGODB_URI=mongodb://localhost:27017/mht_cet_admissions_top20

# Flask Configuration
FLASK_SECRET_KEY=your_secret_key_here
FLASK_ENV=development
FLASK_DEBUG=True

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Workflow Automation
N8N_WEBHOOK_URL=your_n8n_webhook_url_here
MAKE_WEBHOOK_URL=your_make_webhook_url_here

# External Services
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here

# Application Settings
APP_NAME=AdmitAI
APP_VERSION=2.0.0
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:8000